# Copy to `.env` in the repository root (`.env` is gitignored).
# Used by scripts/generate_agent_*_poe*.py and scripts/package_project_logic_bundle.py

# Poe OpenAI-compatible API (GPT-Image-2 via chat completions)
POE_API_KEY=

# MiniMax M3 (LangGraph case pipeline + ReAct; SAM report fallback)
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M3

# DeepSeek (preferred for SAM ultrasound text reports when MiniMax Token Plan is exhausted)
# DEEPSEEK_API_KEY=
# Or place key in docs/clinical_validation/reader_study_v150/server/deepseek_api_key.txt
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# SAM_LLM_PROVIDER=auto  # auto|deepseek|minimax

# Optional overrides
# POE_IMAGE_MODEL=GPT-Image-2
# AGENT_API_KEY=
# VLM_API_KEY=

# Round2 research reader identity (Next.js apps/gastric_scan_next)
# Required in production/research: reverse proxy injects reader ID + HMAC-SHA256(reader_id, secret)
# READER_AUTH_PROXY_SECRET=
# READER_AUTH_ID_HEADER=x-authenticated-reader-id
# READER_AUTH_SIGNATURE_HEADER=x-authenticated-reader-signature
# Local unsigned research auth is development-only and must never be enabled in production:
# READER_ALLOW_UNSIGNED_RESEARCH_AUTH=1
