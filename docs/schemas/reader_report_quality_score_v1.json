{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reader_report_quality_score_v1",
  "title": "Reader report quality score v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "score_id",
    "case_id",
    "reader_id",
    "condition",
    "report_target",
    "rater_id",
    "blinded_to_condition",
    "scores",
    "overall_usable",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "reader_report_quality_score_v1" },
    "score_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string" },
    "reader_id": { "type": "string" },
    "condition": { "enum": ["no_ai", "ai_assisted", "ai_draft_only"] },
    "report_target": {
      "enum": ["ai_draft", "doctor_final_report"],
      "description": "AI draft and doctor final report must be scored separately"
    },
    "rater_id": { "type": "string" },
    "blinded_to_condition": { "type": "boolean" },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "facticity",
        "key_tstage_evidence",
        "conflict_uncertainty_expression",
        "traceability",
        "clinical_usability"
      ],
      "properties": {
        "completeness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Are required findings present without critical omissions?"
        },
        "facticity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Are stated observations consistent with the visible images/video?"
        },
        "key_tstage_evidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Does the report capture wall invasion / serosal / perigastric cues needed for T staging?"
        },
        "conflict_uncertainty_expression": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Are conflicts and uncertainty stated rather than overconfident?"
        },
        "traceability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Can statements be linked to evidence IDs / frames / masks?"
        },
        "clinical_usability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Would a reviewing clinician accept this as a usable draft or final note?"
        }
      }
    },
    "mean_score": { "type": "number", "minimum": 1, "maximum": 5 },
    "overall_usable": { "type": "boolean" },
    "comments": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
